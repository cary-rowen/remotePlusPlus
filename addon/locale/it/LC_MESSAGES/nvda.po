#. Translators: Description of the script to swap NVDA Remote control modes.
#: addon\globalPlugins\remotePlusPlus\__init__.py:177
msgid "Swaps the NVDA Remote control mode between Leader and Follower."
msgstr ""
"Scambia la modalità di controllo remoto di NVDA tra controllore e "
"controllato."

#. Translators: Shown when trying to perform an action that requires a connection.
#: addon\globalPlugins\remotePlusPlus\__init__.py:194
msgctxt "remote"
msgid "Not connected"
msgstr "Non connesso"

