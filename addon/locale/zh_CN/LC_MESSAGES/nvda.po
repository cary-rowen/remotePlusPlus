#. Translators: The audio audio worker rejected its connection or audio settings.
#: addon\globalPlugins\remotePlusPlus\audio.py:121
#: addon\globalPlugins\remotePlusPlus\audio.py:405
#: addon\globalPlugins\remotePlusPlus\audio.py:416
msgid "Audio connection settings are invalid."
msgstr "音频连接设置无效。"

#. Translators: Connecting to or communicating with the audio server failed.
#: addon\globalPlugins\remotePlusPlus\audio.py:124
msgid ""
"Unable to communicate with the audio server. Check the server and connection "
"key."
msgstr "无法与音频服务器通信。请检查服务器和连接密钥。"

#. Translators: The audio server did not accept the UDP audio connection.
#: addon\globalPlugins\remotePlusPlus\audio.py:128
msgid ""
"Unable to establish UDP audio transport. Check the audio server and firewall."
msgstr "无法建立 UDP 音频连接。请检查音频服务器和防火墙。"

#. Translators: No default microphone is available on the computer capturing audio.
#: addon\globalPlugins\remotePlusPlus\audio.py:131
msgid "No default microphone is available."
msgstr "没有可用的默认麦克风。"

#. Translators: No default output device is available for playback or system audio capture.
#: addon\globalPlugins\remotePlusPlus\audio.py:133
msgid "No default audio output device is available."
msgstr "没有可用的默认音频输出设备。"

#. Translators: An audio device could not be opened or stopped working.
#: addon\globalPlugins\remotePlusPlus\audio.py:135
msgid "The audio device is unavailable or stopped working."
msgstr "音频设备不可用或已停止工作。"

#. Translators: Sending or receiving audio data failed.
#: addon\globalPlugins\remotePlusPlus\audio.py:137
msgid "The audio connection failed."
msgstr "音频连接失败。"

#: addon\globalPlugins\remotePlusPlus\audio.py:140
msgid ""
"The Opus audio codec is unavailable or failed. Reinstall Remote++ on both "
"computers."
msgstr "Opus 音频编解码器不可用或运行失败。请在两台计算机上重新安装 Remote++。"

#. Translators: The controlled computer stopped sharing audio, for example when reloading add-ons.
#: addon\globalPlugins\remotePlusPlus\audio.py:143
msgid "Audio sharing stopped on the controlled computer."
msgstr "被控计算机已停止音频共享。"

#. Translators: Fallback for an unknown error from the audio component.
#: addon\globalPlugins\remotePlusPlus\audio.py:146
#: addon\globalPlugins\remotePlusPlus\audio.py:444
#: addon\globalPlugins\remotePlusPlus\audio.py:495
#: addon\globalPlugins\remotePlusPlus\audio.py:583
#: addon\globalPlugins\remotePlusPlus\service.py:757
msgid "Audio component failed."
msgstr "音频组件运行失败。"

#: addon\globalPlugins\remotePlusPlus\audio.py:402
msgid "Audio server host is unavailable."
msgstr "音频服务器地址不可用。"

#: addon\globalPlugins\remotePlusPlus\audio.py:410
msgid "Audio source selection is invalid."
msgstr "音频源选择无效。"

#: addon\globalPlugins\remotePlusPlus\audio.py:419
msgid "No audio source is enabled."
msgstr "未启用音频源。"

#: addon\globalPlugins\remotePlusPlus\audio.py:609
msgid "Audio component stopped unexpectedly."
msgstr "音频组件意外停止。"

