msgstr "是否删除分组“{group}”？其中的连接将被移至默认分组。"

#. Translators: Confirmation message when deleting multiple groups.
#: addon\globalPlugins\remotePlusPlus\interface.py:559
#, python-brace-format
msgid "Delete {count} selected groups? Connections will be moved to Default."
msgstr "是否删除 {count} 个选中分组？其中的连接将被移至默认分组。"

#. Translators: Title of the confirmation dialog for deleting connections.
#: addon\globalPlugins\remotePlusPlus\interface.py:566
#: addon\globalPlugins\remotePlusPlus\interface.py:907
msgid "Confirm Delete"
msgstr "确认删除"

#: addon\globalPlugins\remotePlusPlus\interface.py:582
msgid "Remote Connection Manager"
msgstr "远程连接管理器"

#. Translators: Label for the group dropdown in the connection manager.
#: addon\globalPlugins\remotePlusPlus\interface.py:599
msgid "&Group:"
msgstr "分组(&G)："

#. Translators: Button to open the group management dialog.
#: addon\globalPlugins\remotePlusPlus\interface.py:606
msgid "&Manage Groups..."
msgstr "管理分组(&M)..."

